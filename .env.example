# Copy this file to `.env` for local development.
# None of these are required for the site to build — Phase 1 ships without a backend.

# ---------------------------------------------------------------------------
# Contact form submission endpoint (optional)
# ---------------------------------------------------------------------------
# The contact form at /contact posts to this URL if it is set (e.g. a
# Formspree/Netlify Forms/custom endpoint). See src/config/contact.ts and
# src/lib/contactForm.ts for the integration interface. If left unset, the
# form renders in a clearly labelled demo/non-production state and does not
# claim to submit anywhere.
PUBLIC_CONTACT_FORM_ENDPOINT=

# ---------------------------------------------------------------------------
# Demo content toggle
# ---------------------------------------------------------------------------
# Controls whether sample/demo records (artists, performances, events,
# archive items) are shown. Defaults to "false" — a plain `npm run build`
# or `npm run dev` shows the real, honest, pre-content launch state. Set to
# "true" only for local development or an internal preview when you want to
# see the site laid out with sample content.
# See src/config/site.ts (showDemoContent).
PUBLIC_SHOW_DEMO_CONTENT=false

# ---------------------------------------------------------------------------
# Analytics (optional, off by default)
# ---------------------------------------------------------------------------
# No analytics script is loaded unless this is explicitly set. See README.md
# "Analytics" section for the integration mechanism.
PUBLIC_ANALYTICS_PROVIDER=
PUBLIC_ANALYTICS_ID=
