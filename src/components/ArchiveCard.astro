---
interface Props {
  title: string;
  category: string;
  year?: string;
  location?: string;
  description: string;
  image?: string;
  imageAlt?: string;
  pendingDigitisation?: boolean;
  href?: string;
}

const { title, category, year, location, description, image, imageAlt, pendingDigitisation, href } = Astro.props;
const Tag = href ? 'a' : 'article';
const meta = [category, year, location].filter(Boolean).join(' · ');
---

<Tag class="archive-card card" {...(href ? { href } : {})}>
  {
    image && (
      <div class="media-frame archive-card__image">
        <img src={image} alt={imageAlt ?? ''} loading="lazy" />
        {pendingDigitisation && <span class="archive-card__badge">Being digitised</span>}
      </div>
    )
  }
  <div class="archive-card__body">
    <p class="archive-card__category">{meta}</p>
    <h3 class="archive-card__title">{title}</h3>
    <p class="archive-card__description">{description}</p>
  </div>
</Tag>

<style>
  .archive-card {
    display: flex;
    flex-direction: column;
    background: var(--color-warm-white);
    text-decoration: none;
    color: inherit;
  }

  a.archive-card:hover .archive-card__title {
    color: var(--color-maroon);
  }

  .archive-card__image {
    position: relative;
  }

  .archive-card__badge {
    position: absolute;
    bottom: var(--space-3);
    left: var(--space-3);
    background: color-mix(in srgb, var(--color-wine) 88%, transparent);
    color: var(--color-warm-white);
    font-size: var(--fs-100);
    font-weight: 600;
    padding: var(--space-1) var(--space-3);
    border-radius: 999px;
  }

  .archive-card__body {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .archive-card__category {
    font-size: var(--fs-100);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-accent-teal);
  }

  .archive-card__description {
    font-size: var(--fs-200);
    color: var(--color-text-muted);
  }
</style>
