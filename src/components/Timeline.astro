---
interface TimelineItem {
  marker: string;
  title: string;
  /** Optional secondary line under the title, e.g. a location or registration reference. */
  subtitle?: string;
  description: string;
}

interface Props {
  items: TimelineItem[];
}

const { items } = Astro.props;
---

<ol class="timeline">
  {
    items.map((item) => (
      <li class="timeline__item">
        <div class="timeline__marker">{item.marker}</div>
        <div class="timeline__content">
          <h3 class="timeline__title">{item.title}</h3>
          {item.subtitle && <p class="timeline__subtitle">{item.subtitle}</p>}
          <p class="timeline__description">{item.description}</p>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .timeline {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .timeline__item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-5);
    position: relative;
    padding-bottom: var(--space-6);
    border-left: 2px solid var(--color-border);
    padding-left: var(--space-6);
    margin-left: var(--space-2);
  }

  .timeline__item::before {
    content: '';
    position: absolute;
    left: -6px;
    top: 4px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-gold-antique);
  }

  .timeline__item:last-child {
    border-left-color: transparent;
    padding-bottom: 0;
  }

  .timeline__marker {
    font-family: var(--font-display);
    font-size: var(--fs-400);
    color: var(--color-maroon);
    font-weight: 500;
    white-space: nowrap;
  }

  .timeline__title {
    font-size: var(--fs-400);
  }

  .timeline__subtitle {
    margin-top: var(--space-1);
    font-size: var(--fs-100);
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--color-accent-teal);
  }

  .timeline__description {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    max-width: 34rem;
  }

  @media (max-width: 640px) {
    .timeline__item {
      grid-template-columns: 1fr;
    }
  }
</style>
