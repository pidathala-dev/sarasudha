---
interface Props {
  title: string;
  description: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const { title, description, ctaLabel, ctaHref } = Astro.props;
---

<div class="empty-state">
  <div class="empty-state__motif" aria-hidden="true"></div>
  <h3 class="empty-state__title">{title}</h3>
  <p class="empty-state__description">{description}</p>
  {ctaLabel && ctaHref && (
    <a href={ctaHref} class="btn btn-secondary">{ctaLabel}</a>
  )}
</div>

<style>
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-3);
    padding: var(--space-8) var(--space-5);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
    max-width: 32rem;
    margin-inline: auto;
  }

  .empty-state__motif {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-gold-antique), var(--color-teal));
    opacity: 0.7;
  }

  .empty-state__description {
    color: var(--color-text-muted);
  }
</style>
