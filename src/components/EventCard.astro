---
interface Props {
  title: string;
  date: Date;
  startTime?: string;
  venue: string;
  city: string;
  description: string;
  image?: string;
  imageAlt?: string;
  eventType: string;
  status: 'upcoming' | 'completed' | 'cancelled';
  registrationUrl?: string;
  isDemoContent?: boolean;
}

const {
  title,
  date,
  startTime,
  venue,
  city,
  description,
  image,
  imageAlt,
  eventType,
  status,
  registrationUrl,
  isDemoContent,
} = Astro.props;

const day = new Intl.DateTimeFormat('en-IN', { day: '2-digit' }).format(date);
const month = new Intl.DateTimeFormat('en-IN', { month: 'short' }).format(date);
const year = new Intl.DateTimeFormat('en-IN', { year: 'numeric' }).format(date);
---

<article class:list={['event-card card', { 'event-card--completed': status === 'completed' }]}>
  {
    image && (
      <div class="media-frame event-card__image">
        <img src={image} alt={imageAlt ?? ''} loading="lazy" />
      </div>
    )
  }
  <div class="event-card__body">
    <div class="event-card__date">
      <span class="event-card__day">{day}</span>
      <span class="event-card__month">{month} {year}</span>
    </div>
    <div class="event-card__details">
      <p class="event-card__type">
        {eventType}
        {status === 'cancelled' && <span class="event-card__status">Cancelled</span>}
        {status === 'completed' && <span class="event-card__status event-card__status--completed">Completed</span>}
      </p>
      <h3 class="event-card__title">{title}</h3>
      <p class="event-card__venue">{venue}, {city}{startTime ? ` · ${startTime}` : ''}</p>
      <p class="event-card__description">{description}</p>
      {isDemoContent && <p class="event-card__demo-flag">Demo content</p>}
      {
        registrationUrl && status === 'upcoming' && (
          <a href={registrationUrl} class="btn btn-secondary event-card__cta" rel="noopener noreferrer" target="_blank">
            Register
          </a>
        )
      }
    </div>
  </div>
</article>

<style>
  .event-card {
    display: flex;
    flex-direction: column;
  }

  .event-card--completed {
    background: var(--color-bg-alt);
  }

  .event-card__body {
    display: flex;
    gap: var(--space-5);
    padding: var(--space-5);
  }

  .event-card__date {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 84px;
    padding: var(--space-3);
    border-radius: var(--radius-sm);
    background: var(--color-bg-alt);
    text-align: center;
  }

  .event-card__day {
    font-family: var(--font-display);
    font-size: var(--fs-600);
    line-height: 1;
    color: var(--color-maroon);
  }

  .event-card__month {
    font-size: var(--fs-100);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
  }

  .event-card__details {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .event-card__type {
    font-size: var(--fs-100);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-accent-teal);
    display: flex;
    gap: var(--space-3);
  }

  .event-card__status {
    color: var(--color-maroon);
  }

  .event-card__status--completed {
    color: var(--color-text-muted);
  }

  .event-card__venue {
    font-size: var(--fs-200);
    color: var(--color-text-muted);
  }

  .event-card__description {
    font-size: var(--fs-200);
    color: var(--color-text-muted);
  }

  .event-card__demo-flag {
    font-size: var(--fs-100);
    font-weight: 600;
    color: var(--color-gold-text);
  }

  .event-card__cta {
    align-self: flex-start;
    margin-top: var(--space-3);
  }

  @media (max-width: 480px) {
    .event-card__body {
      flex-direction: column;
    }

    .event-card__date {
      flex-direction: row;
      gap: var(--space-2);
      align-self: flex-start;
    }
  }
</style>
