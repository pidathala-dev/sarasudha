---
/**
 * Community CTA. Phase 1 has no email backend, so this intentionally
 * routes to /participate rather than presenting a signup field that
 * cannot actually submit anywhere.
 */
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Stay close to Sarasudha.',
  description = "There's no newsletter yet — but you can reach us directly, and we'll make sure you hear when there's something to hear.",
} = Astro.props;
---

<section class="newsletter section section--inverse">
  <div class="container newsletter__inner">
    <h2 class="newsletter__title">{title}</h2>
    <p class="newsletter__description">{description}</p>
    <a href="/participate?path=connect" class="btn btn-gold">Stay Connected</a>
  </div>
</section>

<style>
  .newsletter__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-4);
    max-width: 34rem;
    margin-inline: auto;
  }

  .newsletter__title {
    color: var(--color-text-inverse);
  }

  .newsletter__description {
    color: var(--color-text-inverse-muted);
    font-size: var(--fs-400);
  }
</style>
