---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ArchiveCard from '../components/ArchiveCard.astro';
import Timeline from '../components/Timeline.astro';
import EmptyState from '../components/EmptyState.astro';
import CTA from '../components/CTA.astro';
import { showDemoContent } from '../config/site';

const archiveItems = await getCollection('archive', (entry) => showDemoContent || !entry.data.isDemoContent);
const historicalItems = archiveItems.filter((item) => item.data.era === 'historical');
const contemporaryItems = archiveItems.filter((item) => item.data.era === 'contemporary');

const categories = [
  'People',
  'Performances',
  'Photographs',
  'Programmes & Invitations',
  'Newspaper Clippings',
  'Recordings',
  'Documents',
] as const;

const timelineItems = [
  {
    marker: '1984',
    title: 'Annamacharya Kalabharati',
    subtitle: 'Cuddapah · Regn. No. 217/1984',
    description: 'A cultural initiative bringing music, artists and community together.',
  },
  {
    marker: '1997',
    title: 'A community milestone',
    description: 'Public support was sought for a Mandapam, which opened on 22 May 1997.',
  },
  {
    marker: '1998',
    title: '495th Vardhanti',
    description: 'Observances marking Annamacharya’s Vardhanti, recorded 25 March 1998.',
  },
  {
    marker: '2001',
    title: '593rd Jayanti',
    description: 'Further Jayanti programmes recorded 7–8 May 2001.',
  },
  {
    marker: '2010',
    title: 'Protecting the legacy',
    description: 'An archival appeal dated 3 August 2010 called for public support to protect the statue.',
  },
  {
    marker: 'Ongoing',
    title: 'Digitisation',
    description: 'Additional records are still being recovered and catalogued as they are located.',
  },
];
---

<BaseLayout
  title="Heritage"
  description="Keeping memory audible — the Sarasudha archive, tracing back to Annamacharya Kalabharati, Cuddapah, Regn. No. 217/1984."
  path="/heritage"
>
  <PageHero
    eyebrow="Heritage"
    title="Keeping memory audible."
    lede="Photographs, programmes, recordings, documents and memories can preserve what formal histories often leave behind. The Sarasudha archive is being built to bring those fragments together."
    motif="/images/motifs/heritage-motif.svg"
  />

  <section class="section" aria-labelledby="archive-timeline-heading">
    <div class="container container--narrow">
      <SectionHeader
        as="h2"
        id="archive-timeline-heading"
        title="The archive is beginning to speak."
        lede="Recovered family records are beginning to establish a clearer chronology of Annamacharya Kalabharati — from its registration in 1984 through community activity, commemorations and preservation efforts documented in later decades."
      />
      <Timeline items={timelineItems} />
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="categories-heading">
    <div class="container">
      <SectionHeader as="h2" id="categories-heading" eyebrow="The Archive" title="Seven categories, one story." />
      <div class="category-grid">
        {categories.map((category) => (
          <span class="category-chip">{category}</span>
        ))}
      </div>

      <div class="archive-group">
        <p class="archive-group__label">Historical Archive — Annamacharya Kalabharati</p>
        {
          historicalItems.length > 0 ? (
            <div class="archive-grid">
              {historicalItems.map((item) => (
                <ArchiveCard
                  title={item.data.title}
                  category={item.data.category}
                  year={item.data.year}
                  location={item.data.location}
                  description={item.data.description}
                  image={item.data.image}
                  imageAlt={item.data.imageAlt}
                  pendingDigitisation={item.data.pendingDigitisation}
                  href={`/heritage/${item.id}`}
                />
              ))}
            </div>
          ) : (
            <EmptyState
              title="Nothing catalogued here yet."
              description="Material connected to Annamacharya Kalabharati will appear here as it is located and digitised."
              ctaLabel="Have Archival Material?"
              ctaHref="/participate?path=archive"
            />
          )
        }
      </div>

      <div class="archive-group">
        <p class="archive-group__label">Contemporary Archive — Sarasudha</p>
        {
          contemporaryItems.length > 0 ? (
            <div class="archive-grid">
              {contemporaryItems.map((item) => (
                <ArchiveCard
                  title={item.data.title}
                  category={item.data.category}
                  year={item.data.year}
                  location={item.data.location}
                  description={item.data.description}
                  image={item.data.image}
                  imageAlt={item.data.imageAlt}
                  pendingDigitisation={item.data.pendingDigitisation}
                  href={`/heritage/${item.id}`}
                />
              ))}
            </div>
          ) : (
            <EmptyState
              title="This section will grow from here."
              description="Sarasudha's own performances, conversations and programmes will be archived as they happen."
              ctaLabel="Contribute to the Archive"
              ctaHref="/participate?path=archive"
            />
          )
        }
      </div>
    </div>
  </section>

  <CTA
    eyebrow="Contribute"
    title="Help complete the record."
    lede="If you have photographs, recordings, invitations, programmes, newspaper clippings or memories connected with Annamacharya Kalabharati, they may help fill a missing part of this history."
    primaryLabel="Share Archival Material"
    primaryHref="/participate?path=archive"
    secondaryLabel="Contact Sarasudha"
    secondaryHref="/contact?reason=Archive%20contribution"
  />
</BaseLayout>

<style>
  .category-grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-7);
  }

  .category-chip {
    padding: var(--space-2) var(--space-4);
    border-radius: 999px;
    border: 1px solid var(--color-border);
    font-size: var(--fs-100);
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .archive-group {
    margin-bottom: var(--space-8);
  }

  .archive-group:last-child {
    margin-bottom: 0;
  }

  .archive-group__label {
    font-size: var(--fs-100);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-maroon);
    margin-bottom: var(--space-5);
    padding-bottom: var(--space-3);
    border-bottom: var(--border-hairline);
  }

  .archive-grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .archive-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .archive-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
