---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ArchiveCard from '../components/ArchiveCard.astro';
import Timeline from '../components/Timeline.astro';
import CTA from '../components/CTA.astro';
import { showDemoContent } from '../config/site';

const archiveItems = await getCollection('archive', (entry) => showDemoContent || !entry.data.isDemoContent);

const categories = [
  'People',
  'Performances',
  'Photographs',
  'Programmes & Invitations',
  'Newspaper Clippings',
  'Recordings',
  'Documents',
] as const;

const timelineItems = [
  { marker: '1984', title: 'Cuddapah', description: 'Annamacharya Kalabharati begins its cultural journey.' },
  { marker: '2026', title: 'Sarasudha', description: 'The archive finds a new, digital home.' },
  { marker: 'Ongoing', title: 'Digitisation', description: 'Photographs, recordings and documents are catalogued as they are located.' },
];
---

<BaseLayout
  title="Heritage"
  description="Keeping memory audible — the Sarasudha archive of people, performances, photographs, programmes, recordings and documents connected to Annamacharya Kalabharati."
  path="/heritage"
>
  <PageHero
    eyebrow="Heritage"
    title="Keeping memory audible."
    lede="Music survives not only in compositions, but in people, photographs, programmes, recordings and the stories passed between generations."
    motif="/images/motifs/heritage-motif.svg"
  />

  <section class="section" aria-labelledby="archive-timeline-heading">
    <div class="container container--narrow">
      <SectionHeader as="h2" id="archive-timeline-heading" title="An archive still being assembled." />
      <Timeline items={timelineItems} />
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="categories-heading">
    <div class="container">
      <SectionHeader as="h2" id="categories-heading" eyebrow="The Archive" title="Seven categories, one story." />
      <div class="category-grid">
        {categories.map((category) => (
          <span class="category-chip">{category}</span>
        ))}
      </div>

      <div class="archive-grid">
        {archiveItems.map((item) => (
          <ArchiveCard
            title={item.data.title}
            category={item.data.category}
            year={item.data.year}
            description={item.data.description}
            image={item.data.image}
            imageAlt={item.data.imageAlt}
            pendingDigitisation={item.data.pendingDigitisation}
          />
        ))}
      </div>
    </div>
  </section>

  <CTA
    eyebrow="Contribute"
    title="Contribute to the Archive"
    lede="If you have photographs, recordings, programmes or memories connected with Annamacharya Kalabharati or Sarasudha, we would be glad to hear from you."
    primaryLabel="Get in Touch"
    primaryHref="/participate"
    secondaryLabel="Contact Us"
    secondaryHref="/contact"
  />
</BaseLayout>

<style>
  .category-grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-7);
  }

  .category-chip {
    padding: var(--space-2) var(--space-4);
    border-radius: 999px;
    border: 1px solid var(--color-border);
    font-size: var(--fs-100);
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .archive-grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .archive-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .archive-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
