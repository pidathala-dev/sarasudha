---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ArchiveCard from '../components/ArchiveCard.astro';
import Timeline from '../components/Timeline.astro';
import EmptyState from '../components/EmptyState.astro';
import CTA from '../components/CTA.astro';
import { showDemoContent } from '../config/site';

const archiveItems = await getCollection('archive', (entry) => showDemoContent || !entry.data.isDemoContent);
const historicalItems = archiveItems.filter((item) => item.data.era === 'historical');
const contemporaryItems = archiveItems.filter((item) => item.data.era === 'contemporary');

const categories = [
  'People',
  'Performances',
  'Photographs',
  'Programmes & Invitations',
  'Newspaper Clippings',
  'Recordings',
  'Documents',
] as const;

const timelineItems = [
  {
    marker: '1984',
    title: 'Annamacharya Kalabharati',
    subtitle: 'Cuddapah · Regn. No. 217/1984',
    description: 'A cultural initiative bringing music, artists and community together.',
  },
  {
    marker: '2026',
    title: 'Sarasudha',
    description: 'A new chapter — the archive finds a digital home, inspired by that cultural journey.',
  },
  {
    marker: 'Ongoing',
    title: 'Digitisation',
    description: 'Photographs, recordings and documents are catalogued as they are located.',
  },
];
---

<BaseLayout
  title="Heritage"
  description="Keeping memory audible — the Sarasudha archive, tracing back to Annamacharya Kalabharati, Cuddapah, Regn. No. 217/1984."
  path="/heritage"
>
  <PageHero
    eyebrow="Heritage"
    title="Keeping memory audible."
    lede="Music survives not only in compositions, but in people, photographs, programmes, recordings and the stories passed between generations."
    motif="/images/motifs/heritage-motif.svg"
  />

  <section class="section" aria-labelledby="archive-timeline-heading">
    <div class="container container--narrow">
      <SectionHeader as="h2" id="archive-timeline-heading" title="An archive still being assembled." />
      <Timeline items={timelineItems} />
      <div class="registration-block">
        <p class="registration-block__name">Annamacharya Kalabharati</p>
        <p class="registration-block__meta">Cuddapah · Regn. No. 217/1984</p>
      </div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="categories-heading">
    <div class="container">
      <SectionHeader as="h2" id="categories-heading" eyebrow="The Archive" title="Seven categories, one story." />
      <div class="category-grid">
        {categories.map((category) => (
          <span class="category-chip">{category}</span>
        ))}
      </div>

      <div class="archive-group">
        <p class="archive-group__label">Historical Archive — Annamacharya Kalabharati</p>
        {
          historicalItems.length > 0 ? (
            <div class="archive-grid">
              {historicalItems.map((item) => (
                <ArchiveCard
                  title={item.data.title}
                  category={item.data.category}
                  year={item.data.year}
                  description={item.data.description}
                  image={item.data.image}
                  imageAlt={item.data.imageAlt}
                  pendingDigitisation={item.data.pendingDigitisation}
                />
              ))}
            </div>
          ) : (
            <EmptyState
              title="This section is being assembled."
              description="Material connected to Annamacharya Kalabharati will appear here as it is located and digitised."
            />
          )
        }
      </div>

      <div class="archive-group">
        <p class="archive-group__label">Contemporary Archive — Sarasudha</p>
        {
          contemporaryItems.length > 0 ? (
            <div class="archive-grid">
              {contemporaryItems.map((item) => (
                <ArchiveCard
                  title={item.data.title}
                  category={item.data.category}
                  year={item.data.year}
                  description={item.data.description}
                  image={item.data.image}
                  imageAlt={item.data.imageAlt}
                  pendingDigitisation={item.data.pendingDigitisation}
                />
              ))}
            </div>
          ) : (
            <EmptyState
              title="This section will grow from here."
              description="Sarasudha's own performances, conversations and programmes will be archived as they happen."
            />
          )
        }
      </div>
    </div>
  </section>

  <CTA
    eyebrow="Contribute"
    title="Contribute to the Archive"
    lede="If you have photographs, recordings, programmes or memories connected with Annamacharya Kalabharati or Sarasudha, we would be glad to hear from you."
    primaryLabel="Get in Touch"
    primaryHref="/participate"
    secondaryLabel="Contact Us"
    secondaryHref="/contact"
  />
</BaseLayout>

<style>
  .registration-block {
    margin-top: var(--space-6);
    padding: var(--space-5) var(--space-6);
    border-top: 2px solid var(--color-gold-antique);
    max-width: 28rem;
  }

  .registration-block__name {
    font-family: var(--font-display);
    font-size: var(--fs-400);
    color: var(--color-maroon);
  }

  .registration-block__meta {
    margin-top: var(--space-1);
    font-size: var(--fs-200);
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--color-accent-teal);
  }

  .category-grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-7);
  }

  .category-chip {
    padding: var(--space-2) var(--space-4);
    border-radius: 999px;
    border: 1px solid var(--color-border);
    font-size: var(--fs-100);
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .archive-group {
    margin-bottom: var(--space-8);
  }

  .archive-group:last-child {
    margin-bottom: 0;
  }

  .archive-group__label {
    font-size: var(--fs-100);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-maroon);
    margin-bottom: var(--space-5);
    padding-bottom: var(--space-3);
    border-bottom: var(--border-hairline);
  }

  .archive-grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .archive-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .archive-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
