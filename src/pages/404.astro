---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found" description="The page you're looking for could not be found." path="/404" noindex>
  <section class="section not-found">
    <div class="container container--narrow not-found__inner">
      <p class="eyebrow">404</p>
      <h1>This page has gone quiet.</h1>
      <p class="not-found__lede">
        The page you're looking for doesn't exist, or may have moved. Try the navigation above, or
        head back home.
      </p>
      <a href="/" class="btn btn-primary">Return Home</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding-block: var(--space-9);
  }

  .not-found__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: flex-start;
  }

  .not-found__lede {
    color: var(--color-text-muted);
    font-size: var(--fs-300);
    max-width: 34rem;
  }
</style>
